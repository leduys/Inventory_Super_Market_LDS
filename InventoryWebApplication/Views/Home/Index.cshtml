@using InventoryWebApplication.Utils
@{
    ViewBag.Title = "Home";
    ViewBag.PreviousPage = "";
    Layout = "_Layout";
}

<div class="home-container">
    <h1 class="display-4 text-center">Welcome @Role.GetFormattedName(User.Claims.GetRole())</h1>

    <div class="card-deck card-actions">
        @* Card 1: Manage Users *@
        @if (User.HasAccessTo(Role.HrManager))
        {
            <a class="normal-text-link" asp-controller="Users" asp-action="ListUsers">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: users; ratio: 5"></span>
                        <h5 class="card-title">Manage Users</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 2: Payment Methods *@
        @if (User.HasAccessTo(Role.HrManager))
        {
            <a class="normal-text-link" asp-controller="PaymentMethods" asp-action="ListPaymentMethods">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: credit-card; ratio: 5"></span>
                        <h5 class="card-title">Payment Methods</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 3: Manage Products *@
        @if (User.HasAccessTo(Role.StockManager))
        {
            <a class="normal-text-link" asp-controller="Products" asp-action="ListProducts">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: box; ratio: 5"></span>
                        <h5 class="card-title">Manage Products</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 4: Reports *@
        @if (User.HasAccessTo(Role.StockManager))
        {
            <a class="normal-text-link" asp-controller="Reports" asp-action="GeneralReports">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: clipboard; ratio: 5"></span>
                        <h5 class="card-title">Reports</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 5: Sales Menu *@
        @if (User.HasAccessTo(Role.Seller))
        {
            <a class="normal-text-link" asp-controller="Sales" asp-action="SalesMenu">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: bag; ratio: 5"></span>
                        <h5 class="card-title">Sales Menu</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 6: Settings *@
        @if (User.HasAccessTo(Role.HrManager))
        {
            <a class="normal-text-link" asp-controller="Settings" asp-action="Settings">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: settings; ratio: 5"></span>
                        <h5 class="card-title">Settings</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 7: Import Menu *@
        @if (User.HasAccessTo(Role.StockManager))
        {
            <a class="normal-text-link" asp-controller="Import" asp-action="ImportMenu">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: upload; ratio: 5"></span>
                        <h5 class="card-title">Import Menu</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 8: Export Menu *@
        @if (User.HasAccessTo(Role.StockManager))
        {
            <a class="normal-text-link" asp-controller="Export" asp-action="ExportMenu">
                <div class="card">
                    <div class="card-body">
                        <span class="card-img" uk-icon="icon: download; ratio: 5"></span>
                        <h5 class="card-title">Export Menu</h5>
                    </div>
                </div>
            </a>
        }

        @* Card 9: Info (nếu cần) *@
        <div class="card">
            <div class="card-body">
                <span class="card-img" uk-icon="icon: info; ratio: 5"></span>
                <h5 class="card-title">Info</h5>
            </div>
        </div>
    </div>

    @* Logout floating button góc dưới phải màn hình *@
    <a class="logout-floating" asp-controller="Authentication" asp-action="Logout" title="Logout">
        <span uk-icon="icon: sign-out; ratio: 2"></span>
    </a>
</div>

<style>
    .home-container {
        max-width: 1200px;
        margin: 50px auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #004085;
    }

    h1.display-4 {
        margin-bottom: 40px;
        color: #004085;
    }

    /* Grid 3x3 */
    .card-deck {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        justify-items: center;
        margin-top: 30px;
    }

    .card {
        background-color: #cce5ff; /* xanh dương nhạt */
        border-radius: 12px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        width: 180px;
        height: 180px;
        text-align: center;
        transition: transform 0.3s, box-shadow 0.3s;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center; /* căn icon và text vào giữa */
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

    .card-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .card-title {
        font-weight: 600;
        margin-top: 10px;
        color: #004085;
        text-align: center;
    }

    .card-img,
    .card svg,
    .card [uk-icon] {
        display: block;
        margin: 0 auto; /* căn giữa icon */
        color: #004085;
        font-size: 50px;
    }

    .normal-text-link {
        text-decoration: none;
    }

    /* Logout floating button */
    .logout-floating {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background-color: #ff4d4d;
        color: white;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 15px rgba(0,0,0,0.3);
        transition: transform 0.3s, box-shadow 0.3s;
        z-index: 1000;
    }

        .logout-floating:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.35);
        }

        .logout-floating span {
            font-size: 24px;
        }
</style>
