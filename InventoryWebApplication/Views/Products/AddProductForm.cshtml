@{
    ViewBag.Title = "Add Product";
    ViewBag.PreviousPage = "products";
    Layout = "_FormsLayout";
}

<form class="simple-form add-product-form" method="post" asp-controller="Products" asp-action="AddProduct">
    <div class="form-section">
        <div class="form-group">
            <label class="form-label" for="nameInput">Name:</label>
            <input type="text" name="name" id="nameInput" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="descriptionInput">Description:</label>
            <textarea name="description" id="descriptionInput" cols="22" rows="5" required></textarea>
        </div>

        <div class="form-group">
            <label class="form-label" for="availableQuantityInput">Available:</label>
            <input type="number" step="1" min="0" max="@int.MaxValue" name="availableQuantity" id="availableQuantityInput" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="costInput">Cost:</label>
            <input type="number" step="0.01" min="0" max="@float.MaxValue" name="cost" id="costInput" required />
        </div>

        <div class="form-group">
            <label class="form-label" for="sellInput">Sell price:</label>
            <input type="number" step="0.01" min="0" max="@float.MaxValue" name="sell" id="sellInput" required />
        </div>
    </div>

    <div class="form-actions">
        <button class="btn-secondary" type="submit">Add</button>
    </div>
</form>

<style>
    .add-product-form {
        background-color: #cce5ff; /* xanh dương nhạt */
        padding: 30px 35px;
        border-radius: 12px;
        max-width: 550px;
        margin: 40px auto;
        box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .add-product-form .form-section {
            display: flex;
            flex-direction: column;
            gap: 25px; /* khoảng cách đều giữa các dòng */
        }

        .add-product-form .form-group {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }

        .add-product-form .form-label {
            font-weight: 600;
            color: #004085;
            flex: 0 0 40%;
        }

        .add-product-form input[type="text"],
        .add-product-form input[type="number"],
        .add-product-form textarea {
            flex: 1 1 55%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #004085;
            font-size: 14px;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn-secondary {
        background-color: #004085;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
</style>
