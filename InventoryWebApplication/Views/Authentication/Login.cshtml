@model InventoryWebApplication.Operations.MessageOperation

@{
    ViewBag.Title = "Login";
    Layout = "_FormsLayout";
}

<div class="login-container">
    <h2 class="login-title">Welcome Back</h2>
    <form class="login-form" accept-charset="UTF-8" asp-controller="Authentication" asp-action="Authenticate" method="post">
        <div class="form-group">
            <label for="nameInput">Username</label>
            <input name="name" type="text" id="nameInput" placeholder="Enter your username" required>
        </div>

        <div class="form-group">
            <label for="passwordInput">Password</label>
            <input name="password" type="password" id="passwordInput" placeholder="Enter your password" required>
        </div>

        <p class="register-link">
            Don't have an account? <a asp-controller="Authentication" asp-action="Register">Register here</a>
        </p>

        <button class="btn-primary" type="submit">Login</button>
    </form>
</div>

<style>
    /* Container */
    .login-container {
        max-width: 400px;
        margin: 60px auto;
        padding: 30px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-title {
        text-align: center;
        margin-bottom: 25px;
        color: #333333;
    }

    /* Form inputs */
    .login-form .form-group {
        margin-bottom: 20px;
    }

    .login-form label {
        display: block;
        margin-bottom: 6px;
        color: #555555;
        font-weight: 500;
    }

    .login-form input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
        transition: 0.3s;
    }

        .login-form input:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 6px rgba(0,123,255,0.3);
        }

    /* Button */
    .btn-primary {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background-color: #007bff;
        color: #ffffff;
        font-size: 16px;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    /* Register link */
    .register-link {
        text-align: center;
        margin-bottom: 20px;
        font-size: 14px;
        color: #555;
    }

        .register-link a {
            color: #007bff;
            text-decoration: none;
        }

            .register-link a:hover {
                text-decoration: underline;
            }

    }
</style>
